# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. Never commit real keys.

# --- Required -------------------------------------------------------------

# Google Gemini API key (free tier, no billing).
# Get one at https://aistudio.google.com -> "Get API key" -> "Create API key".
# Do NOT enable billing or add a payment method.
GEMINI_API_KEY=

# Tavily API key (free Researcher plan: 1000 credits/month, no card).
# Get one at https://app.tavily.com/home
TAVILY_API_KEY=

# --- Optional (defaults shown) -------------------------------------------
# Both models must be Flash-family and must accept image input.
# Change these if your account exposes different free-tier models.

# Used for AI requests 1 and 2 (text only). Cheapest fast model.
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Used for AI request 3 (includes competitor screenshots). Must accept images.
GEMINI_MODEL_SMART=gemini-3.5-flash
